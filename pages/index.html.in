SPDX-License-Identifier: ISC

Generated by pages/build.sh, which fills the at-sign placeholders from the
artifacts it just built. The netinstall downloads are named for the digest of
demo.cmd, so they cannot come to pin a file that is not the one beside them.

Deliberately unexplained. The list is the page.
-->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>neutrino</title>
<style>
  :root {
    --bg: #ffffff; --fg: #1a1d24; --muted: #8a91a0; --line: #e8eaee; --accent: #0550ae;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12141a; --fg: #e6e8ee; --muted: #6d7585; --line: #232733; --accent: #9ecbff;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Cantarell, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  main { max-width: 32rem; margin: 0 auto; padding: 6rem 1.5rem 8rem; }
  h1 { font-size: 1.5rem; margin: 0 0 4rem; letter-spacing: -.02em; font-weight: 600; }
  h2 { font-size: .78rem; margin: 0 0 .2rem; letter-spacing: .08em;
       text-transform: uppercase; color: var(--muted); font-weight: 500; }
  section + section { margin-top: 3.5rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem 1rem;
       padding: .6rem 0; border-bottom: 1px solid var(--line); }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .size { margin-left: auto; color: var(--muted); font-size: .82rem;
          font-variant-numeric: tabular-nums; white-space: nowrap; }
  footer { margin-top: 6rem; color: var(--muted); font-size: .82rem; }
  footer a { color: var(--muted); }
</style>
</head>
<body>
<main>

<h1>neutrino</h1>

<section>
  <h2>executable - fetches and runs the launcher</h2>
  <ul>
@BINARIES@
  </ul>
</section>

<section>
  <h2>launcher - starts the app</h2>
  <ul>
    <li><a href="demo.cmd" download>demo.cmd</a><span class="size">@DEMOSIZE@</span></li>
  </ul>
</section>

<footer>
  <a href="https://github.com/alganet/neutrino">github.com/alganet/neutrino</a>
</footer>

</main>
</body>
</html>
